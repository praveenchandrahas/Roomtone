#!/usr/bin/env python3
"""theater-ctld: local status and control for the theatre rig (localhost only).

  theater-ctld                 serve http://127.0.0.1:8765  (THEATER_CTL_PORT to change)
  theater-ctld --print-token   print the write token and exit

It is a thin layer. It never touches audio or CamillaDSP's config itself:
  status   = `eq status --json` (cached for about a second) + read-only CamillaDSP websocket queries (if the websocket is on)
  actions  = a fixed table that runs `eq on|off`, `eq mode X`, `eq flavour KIND NAME`, `eq engine on|off` (argv list, no shell)
The router stays the only thing that changes the audio path; if this daemon dies, audio is not affected.

Safety: bound to 127.0.0.1 only (no LAN option). Every request must carry a Host header of 127.0.0.1:PORT or localhost:PORT (DNS rebinding),
a cross-origin Origin is refused, and POST needs the token (a random string kept in a 0600 file, handed only to the page this daemon serves).
Autocal (/autocal): runs are shown from the run folders. The page can also START a run, press Continue / Stop, and APPLY a finished run's proposal, always by
running `python3 -m autocal ...` as a subprocess from a FIXED argv table (no shell, no free-form options; the only variable parts are a run id that matched
^[0-9]{8}-[0-9]{6}$ and a folder this daemon computed). One run at a time; no new run while a trial of an applied profile is pending; playback needs "confirm";
apply needs "confirm" and, for a FAIL verdict, "force" exactly like `autocal apply --force`; simulated runs are never applied (autocal refuses too).
The safety monitor and the -20 dBFS level cap live in autocal and are not reachable from here: there is no option to change them. Stop always works:
it writes control/abort and, for a run this daemon started, sends SIGINT after 3 s and SIGTERM after 8 s if the run is still alive.
Actions that cause about a second of silence (mode, flavour, engine) or make the sound louder (eq off) need "confirm": true while mpv is playing.
"""
import base64, hmac, json, os, re, secrets, shutil, signal, socket, struct, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

VERSION = 1
PORT = int(os.environ.get("THEATER_CTL_PORT", "8765"))
EQ = os.environ.get("THEATER_EQ") or shutil.which("eq") or os.path.expanduser("~/.local/bin/eq")
STATE_DIR = os.path.expanduser(os.environ.get("THEATER_STATE_DIR", "~/.local/state/theater"))
TOKEN_FILE = os.path.join(STATE_DIR, "ctl-token")
WS_HOST, _, _ws_port = os.environ.get("THEATER_CAMILLA_WS", "127.0.0.1:1234").partition(":")
WS_PORT = int(_ws_port or 1234)
WEB_DIR = os.environ.get("THEATER_WEB_DIR") or next((d for d in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "web"),
                                                                   os.path.expanduser("~/.local/share/theater-ctld")) if os.path.isdir(d)), "")
ACTION_TIMEOUT = 30
# keep in step with theater-route (tests/test_ctld.py compares them)
FLAVOURS = {"stereo": ("voice", "balanced", "wide"), "bed": ("subtle", "balanced", "wide")}
PMODES = ("auto", "film", "stereo", "bed")
# CamillaDSP websocket: read-only commands only, enforced here
WS_READ_ONLY = ("GetState", "GetCaptureRate", "GetBufferLevel", "GetClippedSamples", "GetProcessingLoad",
                "GetCaptureSignalPeak", "GetPlaybackSignalPeak", "GetPlaybackSignalRms", "GetVersion")
# hardware order of CamillaDSP's 8 playback channels (linux-theater-dsp set-eq.py: FL FR RL RR FC LFE SL SR; RL and RR are the two ceiling speakers)
LAYOUT = ("FL", "FR", "TFL", "TFR", "FC", "LFE", "SL", "SR")
LEVEL_HZ = 20
LEVEL_STREAMS = threading.BoundedSemaphore(4)


# ------------------------------------------------------------------ a minimal websocket client (RFC 6455, text frames only)
def _recv_exact(s, n):
    buf = b""
    while len(buf) < n:
        chunk = s.recv(n - len(buf))
        if not chunk:
            raise OSError("connection closed")
        buf += chunk
    return buf


def ws_read_frame(s):
    b1, b2 = _recv_exact(s, 2)
    op, ln = b1 & 0x0F, b2 & 0x7F
    if ln == 126:
        ln = struct.unpack(">H", _recv_exact(s, 2))[0]
    elif ln == 127:
        ln = struct.unpack(">Q", _recv_exact(s, 8))[0]
    if ln > 1 << 20:
        raise OSError("frame too large")
    mask = _recv_exact(s, 4) if b2 & 0x80 else None
    data = _recv_exact(s, ln)
    if mask:
        data = bytes(c ^ mask[i % 4] for i, c in enumerate(data))
    return op, data


def ws_send_text(s, text):
    data = text.encode()
    head = bytes([0x81])
    if len(data) < 126:
        head += bytes([0x80 | len(data)])
    else:
        head += bytes([0x80 | 126]) + struct.pack(">H", len(data))
    mask = os.urandom(4)
    s.sendall(head + mask + bytes(c ^ mask[i % 4] for i, c in enumerate(data)))


class WsSession:
    """One websocket connection to CamillaDSP (read-only commands only, enforced here). Raises OSError when it cannot be reached."""
    def __init__(self, host=None, port=None, timeout=1.0):
        host, port = host or WS_HOST, port or WS_PORT
        self.s = socket.create_connection((host, port), timeout=timeout)
        try:
            self.s.settimeout(timeout)
            key = base64.b64encode(os.urandom(16)).decode()
            self.s.sendall((f"GET / HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                            f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
            resp = b""
            while b"\r\n\r\n" not in resp:
                resp += _recv_exact(self.s, 1)
                if len(resp) > 8192:
                    raise OSError("bad handshake")
            if b" 101 " not in resp.split(b"\r\n", 1)[0]:
                raise OSError("websocket handshake refused")
        except BaseException:
            self.s.close(); raise

    def query(self, commands):
        bad = [c for c in commands if c not in WS_READ_ONLY]
        if bad:
            raise ValueError("not a read-only command: " + ", ".join(bad))
        out = {}
        for c in commands:
            ws_send_text(self.s, json.dumps(c))
            while True:
                op, data = ws_read_frame(self.s)
                if op == 0x1:
                    break
                if op == 0x8:
                    raise OSError("closed by CamillaDSP")
            try:
                reply = json.loads(data.decode())
                body = reply.get(c, {}) if isinstance(reply, dict) else {}
                out[c] = body.get("value") if body.get("result") == "Ok" else None
            except (ValueError, AttributeError):
                out[c] = None
        return out

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def ws_query(commands, host=None, port=None, timeout=1.0):
    """Ask CamillaDSP's websocket a list of read-only commands. Returns {command: value or None}; raises OSError if it cannot be reached."""
    bad = [c for c in commands if c not in WS_READ_ONLY]
    if bad:
        raise ValueError("not a read-only command: " + ", ".join(bad))
    sess = WsSession(host, port, timeout)
    try:
        return sess.query(commands)
    finally:
        sess.close()


def level_frame(sess):
    """One sample of the 8 playback channels (after EQ, what drives the amplifier inputs), in dBFS, in LAYOUT order. None where unavailable."""
    v = sess.query(["GetPlaybackSignalPeak", "GetPlaybackSignalRms"])
    def clean(a):
        return [round(float(x), 1) for x in a] if isinstance(a, list) and len(a) == len(LAYOUT) and all(isinstance(x, (int, float)) for x in a) else None
    return {"ok": True, "t": round(time.time(), 3), "peak": clean(v["GetPlaybackSignalPeak"]), "rms": clean(v["GetPlaybackSignalRms"])}


def live_block():
    """Read-only DSP numbers from CamillaDSP (needs the websocket: -p 1234 -a 127.0.0.1 in the unit). Never raises."""
    try:
        v = ws_query(["GetState", "GetCaptureRate", "GetBufferLevel", "GetClippedSamples", "GetProcessingLoad",
                      "GetCaptureSignalPeak", "GetPlaybackSignalPeak"])
    except (OSError, ValueError) as e:
        return {"ok": False, "reason": f"CamillaDSP websocket not reachable ({e.__class__.__name__}); add -p {WS_PORT} -a 127.0.0.1 to the unit"}
    return {"ok": True, "state": v["GetState"], "capture_rate": v["GetCaptureRate"], "buffer_level": v["GetBufferLevel"],
            "clipped_samples": v["GetClippedSamples"], "load_percent": v["GetProcessingLoad"],
            "capture_peak_db": v["GetCaptureSignalPeak"], "playback_peak_db": v["GetPlaybackSignalPeak"]}


# ------------------------------------------------------------------ status snapshot
class Snapshot:
    """Caches one combined status for about a second, so many clients do not run many `eq status` commands."""
    def __init__(self, ttl=1.0):
        self.ttl, self.lock, self.t, self.data, self.underruns = ttl, threading.Lock(), 0.0, None, {"t": 0.0, "n": None}

    def _underruns(self):
        if time.time() - self.underruns["t"] < 10:
            return self.underruns["n"]
        self.underruns["t"] = time.time()
        try:
            r = subprocess.run(["journalctl", "--user", "-u", "camilladsp.service", "--since", "-60s", "-o", "cat", "--no-pager", "-q"],
                               capture_output=True, text=True, timeout=4)
            self.underruns["n"] = r.stdout.count("buffer empty") if r.returncode == 0 else None
        except (OSError, subprocess.TimeoutExpired):
            self.underruns["n"] = None
        return self.underruns["n"]

    def get(self):
        with self.lock:
            if self.data is not None and time.time() - self.t < self.ttl:
                return self.data
            try:
                r = subprocess.run([EQ, "status", "--json"], capture_output=True, text=True, timeout=6)
                d = json.loads(r.stdout) if r.returncode == 0 else {"error": (r.stderr or "eq status failed").strip()[:200]}
            except (OSError, subprocess.TimeoutExpired, ValueError) as e:
                d = {"error": f"eq status unavailable: {e.__class__.__name__}"}
            d["live"] = live_block()
            playing = bool(d.get("apps")) or bool((d.get("mpv") or {}).get("playing"))
            # CamillaDSP logs "buffer empty, outputting silence" about every 21 ms while nothing is playing (verified on the rig 2026-10-26),
            # so the count only means something while audio is playing; when idle it is reported as unknown.
            d["underruns_60s"] = self._underruns() if playing else None
            d["ctld"] = {"version": VERSION}
            self.data, self.t = d, time.time()
            return d


SNAP = Snapshot()
ACTION_LOCK = threading.Lock()


# ------------------------------------------------------------------ actions: a fixed table, nothing else
def plan_action(req, status):
    """Validate a request. Returns (argv tail, current-value check, needs_confirm, note) or raises ValueError(message)."""
    a = req.get("action")
    playing = bool(status.get("mpv", {}).get("playing")) or any(x.get("patched") for x in status.get("apps", []))
    dsp = status.get("dsp", {})
    if a == "eq":
        v = req.get("value")
        if v not in ("on", "off"):
            raise ValueError("eq: value must be on or off")
        return [v], status.get("eq", {}).get("switch") == v, (v == "off" and playing), "EQ off is louder than EQ on"
    if a == "mode":
        v = req.get("value")
        if v not in PMODES:
            raise ValueError("mode: value must be one of " + ", ".join(PMODES))
        return ["mode", v], dsp.get("pmode") == v, playing, "a profile switch can cause about 1 second of silence"
    if a == "flavour":
        k, n = req.get("kind"), req.get("value")
        if k not in FLAVOURS or n not in FLAVOURS[k]:
            raise ValueError("flavour: kind must be stereo or bed, value one of " + ", ".join(sorted({x for t in FLAVOURS.values() for x in t})))
        return ["flavour", k, n], dsp.get("flavours", {}).get(k) == n, playing, "a profile switch can cause about 1 second of silence"
    if a == "engine":
        v = req.get("value")
        if v not in ("on", "off"):
            raise ValueError("engine: value must be on or off")
        cur = dsp.get("engine", {}).get("state")
        return ["engine", v], cur == v, playing, "a profile switch can cause about 1 second of silence"
    raise ValueError("unknown action")


def run_action(req):
    """Returns (http status, body)."""
    status = SNAP.get()
    if "error" in status and "eq" not in status:
        return 503, {"ok": False, "error": status["error"]}
    try:
        argv, already, needs_confirm, note = plan_action(req, status)
    except ValueError as e:
        return 400, {"ok": False, "error": str(e)}
    if already:
        return 200, {"ok": True, "noop": True, "message": "already set"}
    if needs_confirm and req.get("confirm") is not True:
        return 409, {"ok": False, "error": "confirm", "message": note}
    if not ACTION_LOCK.acquire(timeout=1):
        return 429, {"ok": False, "error": "another action is running"}
    try:
        label = " ".join(argv)
        print(f"action: eq {label}", flush=True)
        try:
            r = subprocess.run([EQ, *argv], capture_output=True, text=True, timeout=ACTION_TIMEOUT)
        except (OSError, subprocess.TimeoutExpired) as e:
            return 500, {"ok": False, "error": f"eq failed: {e.__class__.__name__}"}
        SNAP.t = 0.0
        if shutil.which("notify-send"):
            try:
                subprocess.run(["notify-send", "-a", "Home theatre", "-t", "1500", "Control", f"eq {label}"], timeout=2, capture_output=True)
            except (OSError, subprocess.TimeoutExpired):
                pass
        return (200 if r.returncode == 0 else 500), {"ok": r.returncode == 0, "output": (r.stdout + r.stderr).strip()[-400:]}
    finally:
        ACTION_LOCK.release()


# ------------------------------------------------------------------ autocal runs (read-mostly; the only writes are control/continue-<prompt> and control/abort)
ID_RE = re.compile(r"[0-9]{8}-[0-9]{6}")
PROMPT_RE = re.compile(r"[A-Za-z0-9_-]{1,40}")
ACTIVE_STATES = ("idle", "preflight", "ramp", "channel_id", "sweeping", "waiting_user", "analysing")
DEAD_AFTER_S = 60          # an active run whose status.json is older than this is not running any more: no control files are written for it
MAX_JSON = 16 * 1024 * 1024
RUNS_KEEP = 30


def autocal_runs_root():
    """The folder autocal writes its runs to: $THEATER_AUTOCAL_RUNS (the installer sets it to <checkout>/runs), else the usual places. None if there is none."""
    env = os.environ.get("THEATER_AUTOCAL_RUNS")
    cands = [env] if env else [os.path.expanduser(f"~/sdht-workspace/{n}/runs") for n in ("roomtone", "theater-measurement")] + [os.path.expanduser("~/roomtone/runs")]
    for c in cands:
        if c and os.path.isdir(c):
            return os.path.realpath(c)
    return None


def _read_json(path):
    """A small JSON file, or None (missing, unreadable, half-written, a symlink, too big). Never raises."""
    try:
        if os.path.islink(path) or os.path.getsize(path) > MAX_JSON:
            return None
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


def _run_dir(root, rid):
    """The run's folder if rid is a well-formed id and the folder is a real directory directly inside root, else None."""
    if not root or not isinstance(rid, str) or not ID_RE.fullmatch(rid):
        return None
    d = os.path.join(root, rid)
    return d if os.path.isdir(d) and not os.path.islink(d) and os.path.dirname(os.path.realpath(d)) == root else None


def _status_of(d):
    st = _read_json(os.path.join(d, "status.json"))
    if st is None:
        return None
    try:
        age = max(0.0, time.time() - os.stat(os.path.join(d, "status.json")).st_mtime)
    except OSError:
        age = 0.0
    st["age_s"] = round(age, 1)
    st["stale"] = bool(st.get("state") in ACTIVE_STATES and age > DEAD_AFTER_S)
    return st


_verdicts = {}


def _verdict_of(d):
    f = os.path.join(d, "results.json")
    try:
        key = (f, os.stat(f).st_mtime_ns)
    except OSError:
        return None
    if key not in _verdicts:
        r = _read_json(f) or {}
        if len(_verdicts) > 200:
            _verdicts.clear()
        _verdicts[key] = r.get("verdict")
    return _verdicts[key]


def autocal_overview():
    root = autocal_runs_root()
    if root is None:
        return {"ok": True, "found": False, "runs": [], "current": None,
                "hint": "no autocal runs folder found; set THEATER_AUTOCAL_RUNS (re-run gui/install-ctld.sh from your checkout)"}
    runs = []
    try:
        names = sorted((n for n in os.listdir(root) if ID_RE.fullmatch(n)), reverse=True)
    except OSError:
        names = []
    for n in names[:RUNS_KEEP]:
        d = _run_dir(root, n)
        if not d:
            continue
        rj, st = _read_json(os.path.join(d, "run.json")) or {}, _status_of(d) or {}
        runs.append({"id": n, "created": rj.get("created"), "mode": rj.get("mode") or st.get("mode"), "simulated": rj.get("simulated", st.get("simulated")),
                     "state": st.get("state"), "verdict": _verdict_of(d), "message": (st.get("message") or "")[:200]})
    current = _status_of(_run_dir(root, runs[0]["id"])) if runs else None
    return {"ok": True, "found": True, "runs_dir": root, "runs": runs, "current": current, "ready": autocal_repo(root) is not None,
            "trial": trial_state(), "child": {"alive": _child_alive(), "preset": CHILD["preset"], "id": CHILD["id"]} if CHILD["preset"] else None,
            "log": log_tail() if CHILD["preset"] and (_child_alive() or (current and CHILD["id"] == current.get("id"))) else None}


def autocal_detail(rid):
    """What the page shows for one finished run: verdict, summary, warnings, the per-channel table, the commands to type (never run from here)."""
    root = autocal_runs_root(); d = _run_dir(root, rid)
    if not d:
        return 404, {"error": "no such run"}
    r = _read_json(os.path.join(d, "results.json"))
    if r is None:
        return 200, {"ok": True, "id": rid, "has_results": False, "status": _status_of(d)}
    keep = {k: r.get(k) for k in ("id", "created", "mode", "simulated", "target", "verdict", "summary", "warnings", "table", "commands")}
    keep["bass"] = {k: (r.get("bass") or {}).get(k) for k in ("rms_to_target_before_db", "rms_to_target_after_db")}
    keep["heights"] = (r.get("heights") or {})
    keep["heights"] = {k: keep["heights"].get(k) for k in ("trim_new_db", "rms_to_bed_before_db", "rms_to_bed_after_db", "above_5k_matched")}
    return 200, {"ok": True, "has_results": True, "result": keep, "status": _status_of(d)}


def autocal_control(req):
    """POST {action: continue|abort, run, prompt?}. Writes ONE empty file in the run's control/ folder (what the terminal's Enter and Ctrl-C map to). Returns (code, body)."""
    a, rid = req.get("action"), req.get("run")
    if a not in ("continue", "abort"):
        return 400, {"error": "action must be continue or abort"}
    root = autocal_runs_root(); d = _run_dir(root, rid)
    if not d:
        return 404, {"error": "no such run"}
    st = _status_of(d)
    own = a == "abort" and _child_alive() and CHILD["id"] == rid          # a run this daemon started: Stop always works while its process lives
    if own:
        ctl = os.path.join(d, "control")
        try:
            os.makedirs(ctl, exist_ok=True)
            fd = os.open(os.path.join(ctl, "abort"), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644); os.close(fd)
        except FileExistsError:
            pass
        except OSError:
            pass
        _stop_child_later(CHILD["proc"])
        return 200, {"ok": True}
    if not st or st.get("state") not in ACTIVE_STATES:
        return 409, {"error": "this run is not active"}
    if st["stale"]:
        return 409, {"error": f"this run has not updated for {st['age_s']:.0f} s: it is not running any more"}
    ctl = os.path.join(d, "control")
    if not os.path.isdir(ctl) or os.path.islink(ctl):
        return 409, {"error": "the run has no control folder"}
    if a == "continue":
        pr = st.get("prompt") or {}
        pid = pr.get("id")
        if st.get("state") != "waiting_user" or not isinstance(pid, str) or not PROMPT_RE.fullmatch(pid):
            return 409, {"error": "the run is not waiting for you"}
        if req.get("prompt") != pid:
            return 409, {"error": "the question changed; look at the page again"}
        name = f"continue-{pid}"
    else:
        name = "abort"
    try:
        fd = os.open(os.path.join(ctl, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o644)
        os.close(fd)
    except FileExistsError:
        return 200, {"ok": True, "noop": True}
    except OSError as e:
        return 500, {"error": f"could not write the control file ({e.__class__.__name__})"}
    return 200, {"ok": True}


# ------------------------------------------------------------------ autocal stage 2: start a run, apply a proposal (fixed argv, one at a time)
PRESETS = {                       # the only runs the page can start
    "check": ["check"],                                            # preflight, noise floor, level ramp, channel ID (plays quiet sounds)
    "single": ["run", "--mode", "single"],
    "five": ["run", "--mode", "five"],
    "sim-single": ["run", "--simulate", "--mode", "single"],       # no audio, no hardware
    "sim-five": ["run", "--simulate", "--mode", "five"],
}
PLAYS_SOUND = ("check", "single", "five")
ABORT_SIGINT_AFTER_S, ABORT_SIGTERM_AFTER_S = 3.0, 8.0
APPLY_TIMEOUT_S = 120
AUTOCAL_LOCK = threading.Lock()
CHILD = {"proc": None, "id": None, "preset": None, "log": None}


def autocal_repo(root=None):
    """The checkout that holds the `autocal` package: $THEATER_AUTOCAL_REPO, else the folder above runs/. None if it is not there."""
    root = root or autocal_runs_root()
    for c in ([os.environ["THEATER_AUTOCAL_REPO"]] if os.environ.get("THEATER_AUTOCAL_REPO") else ([os.path.dirname(root)] if root else [])):
        if c and os.path.isfile(os.path.join(c, "autocal", "__main__.py")):
            return os.path.realpath(c)
    return None


def _autocal_env(root, repo):
    e = dict(os.environ)
    e["AUTOCAL_RUNS_DIR"] = root
    e["PYTHONPATH"] = repo + (os.pathsep + e["PYTHONPATH"] if e.get("PYTHONPATH") else "")
    return e


def _child_alive():
    p = CHILD["proc"]
    return p is not None and p.poll() is None


def trial_state():
    """The applied-profile trial, if one is pending: {state, run, remaining_s}. Read from autocal's own state file."""
    f = os.path.join(os.path.expanduser(os.environ.get("AUTOCAL_BACKUP_DIR", "~/.local/share/autocal/backups")), "trial.json")
    st = _read_json(f)
    if not st or st.get("state") != "trial":
        return None
    rem = float(st.get("deadline_epoch") or 0) - time.time()
    return {"state": "trial", "run": st.get("run"), "remaining_s": round(rem, 1)} if rem > 0 else None


def _active_run(root):
    """Id of a run (started from anywhere) that is active and still updating, else None."""
    try:
        names = sorted((n for n in os.listdir(root) if ID_RE.fullmatch(n)), reverse=True)[:5]
    except OSError:
        return None
    for n in names:
        d = _run_dir(root, n); st = _status_of(d) if d else None
        if st and st.get("state") in ACTIVE_STATES and not st["stale"]:
            return n
    return None


def log_tail(n=40):
    if not CHILD["log"]:
        return None
    try:
        with open(CHILD["log"], "rb") as f:
            f.seek(0, os.SEEK_END); size = f.tell(); f.seek(max(0, size - 8000))
            return [re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", l) for l in f.read().decode("utf-8", "replace").splitlines()[-n:]]
    except OSError:
        return None


def autocal_start(req):
    preset = req.get("preset")
    if not isinstance(preset, str) or preset not in PRESETS:
        return 400, {"error": "unknown preset"}
    root = autocal_runs_root(); repo = autocal_repo(root)
    if not root or not repo:
        return 409, {"error": "autocal is not set up here (no runs folder or no autocal package); re-run gui/install-ctld.sh from your checkout"}
    with AUTOCAL_LOCK:
        if _child_alive():
            return 409, {"error": f"a run is already in progress ({CHILD['id'] or 'starting'})"}
        busy = _active_run(root)
        if busy:
            return 409, {"error": f"a run is already in progress ({busy})"}
        if trial_state():
            return 409, {"error": "a trial of an applied profile is running: press Keep or Roll back first"}
        if preset in PLAYS_SOUND and req.get("confirm") is not True:
            return 409, {"error": "confirm", "message": ("This plays test sounds through the speakers: quiet chirps first, then sweeps that rise to at most -20 dBFS "
                                                         "(the cap is enforced by autocal). " + {"check": "It checks the microphone, the room noise, the sweep level and that every speaker answers, and stops there. ",
                                                                                                "single": "One position: about 5 minutes. ", "five": "Five positions with the microphone moved between them: about 25 minutes. "}[preset]
                                                         + "The first step checks the microphone and room noise and stops the run before any sound if something is wrong. "
                                                         "Be at the listening position with the microphone in place; stop at any time with Stop the run")}
        log = os.path.join(root, ".ctld-run.log")
        before = set(os.listdir(root))
        try:
            with open(log, "wb") as lf:
                proc = subprocess.Popen([sys.executable, "-m", "autocal", *PRESETS[preset][:1], "--runs-dir", root, *PRESETS[preset][1:]], cwd=repo,
                                        env=_autocal_env(root, repo), stdin=subprocess.DEVNULL, stdout=lf, stderr=subprocess.STDOUT, close_fds=True, start_new_session=True)
        except OSError as e:
            return 500, {"error": f"could not start autocal ({e.__class__.__name__})"}
        CHILD.update(proc=proc, id=None, preset=preset, log=log)
    rid = None
    for _ in range(80):
        time.sleep(0.1)
        fresh = sorted(n for n in os.listdir(root) if n not in before and ID_RE.fullmatch(n))
        if fresh:
            rid = fresh[-1]; CHILD["id"] = rid; break
        if proc.poll() is not None:
            break
    if rid is None and proc.poll() is not None:
        return 500, {"error": f"autocal exited at once (code {proc.returncode})", "output": "\n".join(log_tail() or [])}
    return 200, {"ok": True, "id": rid}


def _stop_child_later(proc):
    def go():
        time.sleep(ABORT_SIGINT_AFTER_S)
        if proc.poll() is None:
            try:
                proc.send_signal(signal.SIGINT)
            except OSError:
                return
        time.sleep(max(0.0, ABORT_SIGTERM_AFTER_S - ABORT_SIGINT_AFTER_S))
        if proc.poll() is None:
            try:
                proc.terminate()
            except OSError:
                pass
    threading.Thread(target=go, daemon=True).start()


def room_changes(before, after):
    """What a proposal changes: [{what, from, to}] between the room the run started from and room.proposed.json."""
    out = []; b, a = before or {}, after or {}
    ba, aa = b.get("align") or {}, a.get("align") or {}
    for ch in sorted(set(ba) | set(aa)):
        for k, label, unit in (("delay_ms", "delay", "ms"), ("trim_db", "trim", "dB")):
            x, y = (ba.get(ch) or {}).get(k), (aa.get(ch) or {}).get(k)
            if isinstance(x, (int, float)) and isinstance(y, (int, float)) and abs(x - y) > 0.004:
                out.append({"what": f"{ch} {label}", "from": f"{x:g} {unit}", "to": f"{y:g} {unit}"})

    def fl(fs):
        return [f"{f.get('type', '?')} {f.get('freq')} Hz {f.get('gain'):+g} dB Q {f.get('q')}" for f in (fs or []) if isinstance(f, dict) and isinstance(f.get("gain"), (int, float))]
    for label, x, y in (("height tone filters", (b.get("height_tone") or {}).get("filters"), (a.get("height_tone") or {}).get("filters")),
                        ("extra bass filters", (b.get("bass") or {}).get("extra_filters"), (a.get("bass") or {}).get("extra_filters"))):
        if fl(x) != fl(y):
            out.append({"what": label, "from": "; ".join(fl(x)) or "none", "to": "; ".join(fl(y)) or "none"})
    tx, ty = (b.get("height_tone") or {}).get("trim_db"), (a.get("height_tone") or {}).get("trim_db")
    if isinstance(tx, (int, float)) and isinstance(ty, (int, float)) and abs(tx - ty) > 0.004:
        out.append({"what": "height tone trim", "from": f"{tx:g} dB", "to": f"{ty:g} dB"})
    return out


def autocal_preview(rid):
    root = autocal_runs_root(); d = _run_dir(root, rid)
    if not d:
        return 404, {"error": "no such run"}
    res = _read_json(os.path.join(d, "results.json")); rj = _read_json(os.path.join(d, "run.json")) or {}
    prop = _read_json(os.path.join(d, "room.proposed.json"))
    if res is None:
        return 200, {"ok": True, "can_apply": False, "why_not": "this run has no result (it did not finish)"}
    simulated = bool(res.get("simulated"))
    out = {"ok": True, "id": rid, "verdict": res.get("verdict"), "summary": res.get("summary"), "warnings": res.get("warnings") or [], "simulated": simulated,
           "changes": room_changes(rj.get("room_before"), prop) if prop is not None else None, "force_needed": res.get("verdict") == "FAIL",
           "trial": "The new profile starts a timed trial: it goes back to the old one by itself unless you press Keep."}
    why = None
    if prop is None or not os.path.isfile(os.path.join(d, "config.proposed.yml")):
        why = "the run has no proposed config (nothing to apply)"
    elif simulated:
        why = "this run is SIMULATED; it is never installed on the real system"
    elif trial_state():
        why = "a trial is already running: press Keep or Roll back first"
    elif _child_alive() or _active_run(root):
        why = "a run is in progress"
    out["can_apply"], out["why_not"] = why is None, why
    return 200, out


def _run_autocal(tail, timeout):
    root = autocal_runs_root(); repo = autocal_repo(root)
    if not root or not repo:
        return 409, {"error": "autocal is not set up here; re-run gui/install-ctld.sh from your checkout"}
    try:
        r = subprocess.run([sys.executable, "-m", "autocal", *tail], cwd=repo, env=_autocal_env(root, repo), stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 504, {"error": "autocal did not finish in time; check `autocal keep` / `autocal rollback` in a terminal"}
    except OSError as e:
        return 500, {"error": f"could not run autocal ({e.__class__.__name__})"}
    return 200, {"ok": r.returncode == 0, "returncode": r.returncode, "output": ((r.stdout or "") + (r.stderr or ""))[-4000:]}


def autocal_apply(req):
    rid = req.get("run")
    code, pv = autocal_preview(rid)
    if code != 200:
        return code, pv
    if not pv.get("can_apply"):
        return 409, {"error": pv.get("why_not") or "cannot apply this run"}
    if req.get("confirm") is not True:
        return 409, {"error": "confirm", "message": f"Apply run {rid}? It changes the live CamillaDSP profile and room settings (a backup is made first) and starts a timed trial."}
    if pv["force_needed"] and req.get("force") is not True:
        return 409, {"error": "force", "message": f"The verdict of run {rid} is FAIL. autocal refuses this unless you force it. Apply anyway?"}
    if not AUTOCAL_LOCK.acquire(blocking=False):
        return 429, {"error": "another autocal action is running"}
    try:
        root = autocal_runs_root()
        return _run_autocal(["apply", "--runs-dir", root, rid] + (["--force"] if pv["force_needed"] else []), APPLY_TIMEOUT_S)
    finally:
        AUTOCAL_LOCK.release()


def autocal_trial(req):
    a = req.get("action")
    if a not in ("keep", "rollback"):
        return 400, {"error": "action must be keep or rollback"}
    if a == "rollback" and req.get("confirm") is not True:
        return 409, {"error": "confirm", "message": "Restore the profile that was live before the last apply?"}
    if not AUTOCAL_LOCK.acquire(blocking=False):
        return 429, {"error": "another autocal action is running"}
    try:
        return _run_autocal([a], 60)
    finally:
        AUTOCAL_LOCK.release()


# ------------------------------------------------------------------ HTTP
def load_token():
    os.makedirs(STATE_DIR, exist_ok=True)
    try:
        with open(TOKEN_FILE) as f:
            t = f.read().strip()
            if len(t) >= 32:
                return t
    except OSError:
        pass
    t = secrets.token_urlsafe(32)
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(t + "\n")
    return t


TOKEN = None


class Handler(BaseHTTPRequestHandler):
    server_version = "theater-ctld"
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _host_ok(self):
        return (self.headers.get("Host") or "").lower() in (f"127.0.0.1:{self.server.server_port}", f"localhost:{self.server.server_port}")

    def _origin_ok(self):
        o = self.headers.get("Origin")
        return o is None or o.lower() in (f"http://127.0.0.1:{self.server.server_port}", f"http://localhost:{self.server.server_port}")

    def _send(self, code, body, ctype="application/json", extra=None):
        data = body if isinstance(body, bytes) else (json.dumps(body) if not isinstance(body, str) else body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype + ("; charset=utf-8" if ctype.startswith("text") or ctype == "application/json" else ""))
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy", "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def _gate(self):
        if not self._host_ok():
            self._send(421, {"error": "bad Host header"}); return False
        if not self._origin_ok():
            self._send(403, {"error": "cross-origin request refused"}); return False
        return True

    def do_GET(self):
        if not self._gate():
            return
        path = self.path.split("?", 1)[0]
        if path in ("/", "/index.html"):
            try:
                html = open(os.path.join(WEB_DIR, "index.html"), "rb").read()
            except OSError:
                return self._send(500, {"error": "web/index.html not found (THEATER_WEB_DIR)"})
            return self._send(200, html.replace(b"__TOKEN__", TOKEN.encode()), "text/html")
        if path == "/v1/status":
            return self._send(200, SNAP.get())
        if path in ("/autocal", "/autocal.html"):
            try:
                html = open(os.path.join(WEB_DIR, "autocal.html"), "rb").read()
            except OSError:
                return self._send(500, {"error": "autocal.html not found (THEATER_WEB_DIR); re-run gui/install-ctld.sh"})
            return self._send(200, html.replace(b"__TOKEN__", TOKEN.encode()), "text/html")
        if path == "/v1/autocal":
            return self._send(200, autocal_overview())
        if path == "/v1/autocal/preview":
            q = dict(p.split("=", 1) for p in (self.path.split("?", 1) + [""])[1].split("&") if "=" in p)
            code, body = autocal_preview(q.get("id", ""))
            return self._send(code, body)
        if path == "/v1/autocal/run":
            q = dict(p.split("=", 1) for p in (self.path.split("?", 1) + [""])[1].split("&") if "=" in p)
            code, body = autocal_detail(q.get("id", ""))
            return self._send(code, body)
        if path == "/v1/levels":
            return self._levels()
        if path == "/v1/events":
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.end_headers()
            last, beat = None, 0
            try:
                while True:
                    cur = json.dumps(SNAP.get(), sort_keys=True)
                    stripped = json.dumps({k: v for k, v in json.loads(cur).items() if k != "time"}, sort_keys=True)
                    if stripped != last or beat >= 5:
                        self.wfile.write(f"data: {cur}\n\n".encode()); self.wfile.flush()
                        last, beat = stripped, 0
                    time.sleep(1.0); beat += 1
            except (OSError, ValueError):
                return
        self._send(404, {"error": "not found"})

    def _levels(self):
        """Server-sent stream of per-channel playback levels, LEVEL_HZ per second, from one persistent read-only websocket to CamillaDSP."""
        if not LEVEL_STREAMS.acquire(blocking=False):
            return self._send(429, {"error": "too many level streams"})
        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.write(("data: " + json.dumps({"layout": LAYOUT, "hz": LEVEL_HZ}) + "\n\n").encode()); self.wfile.flush()
            sess, step = None, 1.0 / LEVEL_HZ
            try:
                while True:
                    t0 = time.time()
                    try:
                        if sess is None:
                            sess = WsSession()
                        msg = level_frame(sess)
                    except (OSError, ValueError) as e:
                        if sess:
                            sess.close()
                        sess = None
                        msg = {"ok": False, "reason": f"CamillaDSP websocket not reachable ({e.__class__.__name__})"}
                        step = 2.0
                    else:
                        step = 1.0 / LEVEL_HZ
                    self.wfile.write(("data: " + json.dumps(msg) + "\n\n").encode()); self.wfile.flush()
                    time.sleep(max(0.005, step - (time.time() - t0)))
            except (OSError, ValueError):
                return
            finally:
                if sess:
                    sess.close()
        finally:
            LEVEL_STREAMS.release()

    def do_POST(self):
        if not self._gate():
            return
        ppath = self.path.split("?", 1)[0]
        if ppath not in ("/v1/action", "/v1/autocal/control", "/v1/autocal/start", "/v1/autocal/apply", "/v1/autocal/trial"):
            return self._send(404, {"error": "not found"})
        if not hmac.compare_digest((self.headers.get("X-Theater-Token") or "").encode(), TOKEN.encode()):
            return self._send(401, {"error": "token missing or wrong"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            req = json.loads(self.rfile.read(min(n, 4096)).decode() or "{}")
            if not isinstance(req, dict):
                raise ValueError
        except (ValueError, OSError):
            return self._send(400, {"error": "body must be a JSON object"})
        code, body = {"/v1/autocal/control": autocal_control, "/v1/autocal/start": autocal_start, "/v1/autocal/apply": autocal_apply,
                      "/v1/autocal/trial": autocal_trial}.get(ppath, run_action)(req)
        self._send(code, body)


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    global TOKEN
    TOKEN = load_token()
    if "--print-token" in sys.argv:
        print(TOKEN); return
    srv = Server(("127.0.0.1", PORT), Handler)
    print(f"theater-ctld {VERSION} on http://127.0.0.1:{srv.server_port}  (eq: {EQ}; web: {WEB_DIR or 'missing'})", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
