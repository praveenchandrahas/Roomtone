[Unit]
Description=Theatre status and control page (localhost only)
After=theater-router.service
Wants=theater-router.service

[Service]
Type=simple
ExecStart=%h/.local/bin/theater-ctld
Environment=THEATER_AUTOCAL_RUNS=%h/sdht-workspace/roomtone/runs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
