[Unit]
Description=Theatre status and control page (localhost only)
After=theater-router.service
Wants=theater-router.service

[Service]
Type=simple
ExecStart=%h/.local/bin/theater-ctld
Environment=THEATER_AUTOCAL_RUNS=%h/sdht-workspace/roomtone/runs
Environment=THEATER_AUTOCAL_REPO=%h/sdht-workspace/roomtone
# autocal runs and the apply trial watchdog are children of this service: restarting the page must not kill a run or the watchdog that reverts a trial
KillMode=process
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
